/**
 * Cloudflare Pages Function: /api/save-config
 * ─────────────────────────────────────────────────────────────
 * Saves dashboard_config.json to GitHub repo.
 * GITHUB_TOKEN stored in Cloudflare environment variables —
 * never exposed in repo or to the browser.
 */

const REPO        = 'neaidasm/EVTHSArchive';
const CONFIG_PATH = 'data/dashboard_config.json';
const BRANCH      = 'main';

export async function onRequestPost(context) {
  const { request, env } = context;

  // ── Check token is configured ─────────────────────────────────
  const GITHUB_TOKEN = env.GITHUB_TOKEN;
  if (!GITHUB_TOKEN) {
    return Response.json(
      { success: false, error: 'GitHub token not configured on server. Ask admin to set GITHUB_TOKEN in Cloudflare.' },
      { status: 500 }
    );
  }

  // Parse request body
  let config;
  try {
    const body = await request.json();
    config     = body.config;
    if (!config) throw new Error('No config provided');
  } catch {
    return Response.json({ success: false, error: 'Invalid request body' }, { status: 400 });
  }

  const ghHeaders = {
    Authorization:  `token ${GITHUB_TOKEN}`,
    Accept:         'application/vnd.github.v3+json',
    'Content-Type': 'application/json',
    'User-Agent':   'EVTHS-Dashboard'
  };

  // ── Step 1: Get current file SHA ──────────────────────────────
  let currentSHA = null;
  try {
    const getResp = await fetch(
      `https://api.github.com/repos/${REPO}/contents/${CONFIG_PATH}?ref=${BRANCH}`,
      { headers: ghHeaders }
    );
    if (getResp.ok) {
      const data = await getResp.json();
      currentSHA = data.sha;
    }
  } catch (err) {
    console.warn('[SaveConfig] Could not fetch current SHA:', err.message);
  }

  // ── Step 2: Commit updated config ─────────────────────────────
  const jsonString = JSON.stringify(config, null, 2);
  // Cloudflare Workers use btoa for base64 encoding
  const content    = btoa(unescape(encodeURIComponent(jsonString)));

  const timestamp = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });
  const commitBody = {
    message: `Dashboard config update · ${timestamp}`,
    content,
    branch: BRANCH,
    ...(currentSHA ? { sha: currentSHA } : {})
  };

  try {
    const putResp = await fetch(
      `https://api.github.com/repos/${REPO}/contents/${CONFIG_PATH}`,
      { method: 'PUT', headers: ghHeaders, body: JSON.stringify(commitBody) }
    );

    if (putResp.ok) {
      const result = await putResp.json();
      return Response.json({
        success: true,
        sha:     result.content.sha,
        message: 'Config saved to GitHub successfully'
      });
    } else {
      const err = await putResp.json();
      console.error('[SaveConfig] GitHub API error:', err);
      return Response.json(
        { success: false, error: err.message || 'GitHub rejected the update' },
        { status: putResp.status }
      );
    }
  } catch (err) {
    console.error('[SaveConfig] Network error:', err.message);
    return Response.json(
      { success: false, error: 'Network error when contacting GitHub' },
      { status: 500 }
    );
  }
}

// Block all non-POST requests
export async function onRequest(context) {
  if (context.request.method === 'POST') {
    return onRequestPost(context);
  }
  return new Response('Method Not Allowed', { status: 405 });
}
